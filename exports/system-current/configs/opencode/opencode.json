  "tools": {
    "bash": true,
    "edit": true,
    "write": true,
    "read": true
  },
  "share": "manual",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "shred *": "ask",
      "wipefs *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "git clean *": "ask",
      "git reset --hard*": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git branch -D *": "ask",
      "git rebase *": "ask",
      "git filter-repo *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker system prune*": "ask",
      "docker container prune*": "ask",
      "docker image prune*": "ask",
      "docker volume prune*": "ask",
      "docker compose down *": "ask",
      "kubectl delete *": "ask",
      "kubectl replace *": "ask",
      "kubectl apply *": "ask",
      "kubectl patch *": "ask",
      "kubectl scale *": "ask",
      "kubectl rollout undo *": "ask"
    }
  },
  "mcp": {
    "clickup": {
      "type": "remote",
      "url": "https://mcp.clickup.com/mcp",
      "enabled": true
    }
  },
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
