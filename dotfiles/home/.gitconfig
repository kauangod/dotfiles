[init]
	defaultBranch = master
[user]
	email = kkauannunes@gmail.com
	name = Kauan Godoy Nunes
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[pull]
  rebase = true
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
